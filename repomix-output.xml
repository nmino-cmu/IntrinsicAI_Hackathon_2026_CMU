    <parent link="$(arg cam_mount_tf_prefix)cam_mount_link"/>
    <child link="$(arg right_camera_tf_prefix)camera_link"/>
  </joint>

  <joint name="attach_gripper" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
