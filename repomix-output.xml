       ******************* -->

  <joint name="attach_center_camera" type="fixed">
    <origin xyz="0 -0.1077 -.00719" rpy="0 -1.30899630 1.57079623"/>
    <parent link="$(arg cam_mount_tf_prefix)cam_mount_link"/>
    <child link="$(arg center_camera_tf_prefix)camera_link"/>
  </joint>

  <!-- *****************
       ** left_camera **
       ***************** -->

  <joint name="attach_left_camera" type="fixed">
    <origin xyz="-0.09326 -0.053843 -0.007188" rpy="0 -1.30899630 0.523599027"/>
    <parent link="$(arg cam_mount_tf_prefix)cam_mount_link"/>
    <child link="$(arg left_camera_tf_prefix)camera_link"/>
  </joint>

  <!-- ******************
