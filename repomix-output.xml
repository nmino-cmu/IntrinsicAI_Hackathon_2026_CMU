  <xacro:arg name="y" default="0.0" />
  <xacro:arg name="z" default="0.0" />
  <xacro:arg name="roll" default="0.0" />
  <xacro:arg name="pitch" default="0.0" />
  <xacro:arg name="yaw" default="0.0" />

  <!-- Configure hardware plugin -->
  <xacro:arg name="hardware_plugin" default="gz_ros2_control/GazeboSimSystem"/>

  <!-- create link fixed to the "world" -->
  <link name="world" />
  <link name="tabletop" />

  <joint name="tabletop_joint" type="fixed">
    <origin xyz="$(arg x) $(arg y) $(arg z)" rpy="$(arg roll) $(arg pitch) $(arg yaw)" />
    <parent link="world"/>
    <child link="tabletop"/>
  </joint>

