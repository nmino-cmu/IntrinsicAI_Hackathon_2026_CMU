  <xacro:arg name="safety_k_position" default="20"/>

  <xacro:arg name="simulation_controllers" default="" />
  <xacro:arg name="ros_namespace" default="" />

  <xacro:arg name="ati_tf_prefix" default="ati/" />
  <xacro:arg name="cam_mount_tf_prefix" default="cam_mount/" />
  <xacro:arg name="left_camera_tf_prefix" default="left_camera/"/>
  <xacro:arg name="center_camera_tf_prefix" default="center_camera/"/>
  <xacro:arg name="right_camera_tf_prefix" default="right_camera/"/>
  <xacro:arg name="gripper_tf_prefix" default="gripper/"/>
