  <xacro:robotiq_hande
    name="gripper"
    tf_prefix="$(arg gripper_tf_prefix)"
    grip_pos_min="0.0"
    grip_pos_max="0.025"
    grip_vel_max="0.05"
    grip_effort_min="20"
    grip_effort_max="130"
    initial_pos="$(arg gripper_initial_pos)"
    >
  </xacro:robotiq_hande>

  <joint name="attach_cam_mount" type="fixed">
    <origin xyz="0 0 -.0265" rpy="0 0 0"/>
    <parent link="$(arg tf_prefix)tool0"/>
    <child link="$(arg cam_mount_tf_prefix)cam_mount_link"/>
  </joint>

  <joint name="attach_ft_sensor_joint" type="fixed">
    <origin xyz="0 0 0.0265" rpy="0 0 0"/>
    <parent link="$(arg cam_mount_tf_prefix)cam_mount_link"/>
    <child link="$(arg ati_tf_prefix)base_link"/>
  </joint>

  <!-- *******************
